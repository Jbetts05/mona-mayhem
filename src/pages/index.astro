---

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Mona Mayhem - GitHub Contribution Battle Arena</title>
	</head>
	<body>
		<main class="arena">
			<section class="hero" aria-labelledby="page-title">
				<p class="eyebrow">GitHub Contribution Battle Arena</p>
				<h1 id="page-title">Mona Mayhem</h1>
				<p class="intro">
					Enter two GitHub usernames and see who owns the contribution graph.
				</p>
			</section>

			<section class="battle-panel" aria-label="Choose battle players">
				<p id="battle-help" class="sr-only">
					Press Enter in either username field or activate Battle to compare
					contributions. Validation feedback and results appear below.
				</p>

				<div class="player-field">
					<label for="player-one">Player 1</label>
					<input
						id="player-one"
						name="player-one"
						type="text"
						placeholder="octocat"
						autocomplete="off"
						aria-describedby="battle-help player-one-error"
						aria-invalid="false"
						aria-required="true"
						spellcheck="false"
					/>
					<p id="player-one-error" class="field-error" aria-live="polite"></p>
				</div>

				<div class="versus" aria-hidden="true">VS</div>

				<div class="player-field">
					<label for="player-two">Player 2</label>
					<input
						id="player-two"
						name="player-two"
						type="text"
						placeholder="torvalds"
						autocomplete="off"
						aria-describedby="battle-help player-two-error"
						aria-invalid="false"
						aria-required="true"
						spellcheck="false"
					/>
					<p id="player-two-error" class="field-error" aria-live="polite"></p>
				</div>

				<button id="battle-button" type="button" aria-controls="results">Battle!</button>
			</section>

			<section
				id="results"
				class="results"
				aria-live="polite"
				aria-atomic="true"
				aria-labelledby="results-heading"
				tabindex="-1"
			>
				<h2 id="results-heading" class="sr-only">Battle results</h2>
				<p class="muted">Enter two GitHub usernames to start a battle.</p>
			</section>
		</main>

		<script>
			type ContributionData = {
				total_contributions: number;
				from?: string;
				to?: string;
				colors_full?: string[];
				weeks?: ContributionWeek[];
			};

			type ContributionWeek = {
				first_day: string;
				contribution_days: ContributionDay[];
			};

			type ContributionDay = {
				weekday: number;
				count: number;
				level: number;
			};

			type BattlePlayer = {
				username: string;
				data: ContributionData;
			};

			type PlayerSlot = 'player-one' | 'player-two';

			type PlayerOutcome = 'winner' | 'loser' | 'tie';

			const playerOneInput = document.querySelector<HTMLInputElement>('#player-one');
			const playerTwoInput = document.querySelector<HTMLInputElement>('#player-two');
			const playerOneError = document.querySelector<HTMLElement>('#player-one-error');
			const playerTwoError = document.querySelector<HTMLElement>('#player-two-error');
			const battleButton = document.querySelector<HTMLButtonElement>('#battle-button');
			const results = document.querySelector<HTMLElement>('#results');

			class ContributionFetchError extends Error {
				constructor(
					readonly slot: PlayerSlot,
					message: string,
					readonly status: number
				) {
					super(message);
					this.name = 'ContributionFetchError';
				}
			}

			battleButton?.addEventListener('click', () => {
				void runBattle();
			});

			for (const [input, errorTarget] of [
				[playerOneInput, playerOneError],
				[playerTwoInput, playerTwoError],
			] as const) {
				input?.addEventListener('input', () => {
					clearFieldError(input, errorTarget);
				});

				input?.addEventListener('keydown', (event) => {
					if (event.key === 'Enter') {
						void runBattle();
					}
				});
			}

			async function runBattle() {
				if (!playerOneInput || !playerTwoInput || !battleButton || !results) {
					return;
				}

				const playerOne = playerOneInput.value.trim();
				const playerTwo = playerTwoInput.value.trim();

				clearFieldErrors();

				if (!validatePlayers(playerOne, playerTwo)) {
					return;
				}

				setBattleBusy(true);
				renderMessage('Loading contribution data...', 'loading');

				try {
					const [playerOneData, playerTwoData] = await Promise.all([
						fetchContributionData(playerOne, 'player-one'),
						fetchContributionData(playerTwo, 'player-two'),
					]);

					renderResults([
						{ username: playerOne, data: playerOneData },
						{ username: playerTwo, data: playerTwoData },
					]);
				} catch (error) {
					if (error instanceof ContributionFetchError) {
						const input = error.slot === 'player-one' ? playerOneInput : playerTwoInput;
						const errorTarget =
							error.slot === 'player-one' ? playerOneError : playerTwoError;
						const username = error.slot === 'player-one' ? playerOne : playerTwo;

						setFieldError(
							input,
							errorTarget,
							`Signal lost for @${username}. Check this fighter or retry.`
						);
						input?.focus();
					}

					renderMessage(
						error instanceof Error
							? error.message
							: 'Unable to complete the battle. Try again.',
						'error'
					);
					if (!(error instanceof ContributionFetchError)) {
						focusResults();
					}
				} finally {
					setBattleBusy(false);
				}
			}

			function validatePlayers(playerOne: string, playerTwo: string) {
				const fields = [
					{
						input: playerOneInput,
						errorTarget: playerOneError,
						value: playerOne,
						label: 'Player 1',
					},
					{
						input: playerTwoInput,
						errorTarget: playerTwoError,
						value: playerTwo,
						label: 'Player 2',
					},
				];
				let firstInvalidInput: HTMLInputElement | null = null;

				for (const field of fields) {
					if (!field.value) {
						setFieldError(
							field.input,
							field.errorTarget,
							`Insert coin: ${field.label} needs a GitHub username.`
						);
						firstInvalidInput ??= field.input;
					} else if (!isValidGitHubUsername(field.value)) {
						setFieldError(
							field.input,
							field.errorTarget,
							'Use 1-39 letters, numbers, or single hyphens; no edge hyphens.'
						);
						firstInvalidInput ??= field.input;
					}
				}

				if (firstInvalidInput) {
					renderMessage('Battle blocked. Fix the neon-marked field and launch again.', 'error');
					firstInvalidInput.focus();

					return false;
				}

				return true;
			}

			async function fetchContributionData(
				username: string,
				slot: PlayerSlot
			): Promise<ContributionData> {
				const response = await fetch(
					`/api/contributions/${encodeURIComponent(username)}`
				);
				const body: unknown = await response.json().catch(() => ({}));

				if (!response.ok) {
					throw new ContributionFetchError(
						slot,
						formatApiError(username, getApiError(body), response.status),
						response.status
					);
				}

				return body as ContributionData;
			}

			function renderResults(players: [BattlePlayer, BattlePlayer]) {
				if (!results) {
					return;
				}

				const [playerOne, playerTwo] = players;
				const playerOneTotal = playerOne.data.total_contributions;
				const playerTwoTotal = playerTwo.data.total_contributions;
				const maxTotal = Math.max(playerOneTotal, playerTwoTotal);
				const isTie = playerOneTotal === playerTwoTotal;
				const winner = playerOneTotal > playerTwoTotal ? playerOne : playerTwo;
				const margin = Math.abs(playerOneTotal - playerTwoTotal);

				results.setAttribute('aria-busy', 'false');
				results.innerHTML = `
					<h2 id="results-heading" class="sr-only">Battle results</h2>
					<div class="battle-results">
						<div class="winner-banner ${isTie ? 'is-tie' : ''}">
							<span class="champion-label">${isTie ? 'Final result' : 'Mayhem champion'}</span>
							<strong>${escapeHtml(isTie ? 'Draw game' : winner.username)}</strong>
							<span>${isTie ? 'Evenly matched' : `${margin.toLocaleString()} contribution lead`}</span>
						</div>

						<div class="result-grid">
							${renderPlayerResult(
								playerOne,
								isTie ? 'tie' : playerOne === winner ? 'winner' : 'loser',
								maxTotal
							)}
							<div class="result-versus" aria-hidden="true"><span>VS</span></div>
							${renderPlayerResult(
								playerTwo,
								isTie ? 'tie' : playerTwo === winner ? 'winner' : 'loser',
								maxTotal
							)}
						</div>
					</div>
				`;
				focusResults();
			}

			function renderPlayerResult(
				player: BattlePlayer,
				outcome: PlayerOutcome,
				maxTotal: number
			) {
				const total = player.data.total_contributions;
				const scoreWidth = maxTotal > 0 ? Math.max((total / maxTotal) * 100, 3) : 0;
				const outcomeLabel =
					outcome === 'tie' ? 'Dead heat' : outcome === 'winner' ? 'Winner' : 'Challenger';
				const dateRange =
					player.data.from && player.data.to
						? `<p class="date-range">${escapeHtml(player.data.from)} to ${escapeHtml(player.data.to)}</p>`
						: '';

				const playerSummary = `${outcomeLabel}: ${player.username} has ${total.toLocaleString()} contributions`;

				return `
					<article class="player-result is-${outcome}" aria-label="${escapeHtml(playerSummary)}">
						<p class="player-kicker">${outcomeLabel}</p>
						<h2>@${escapeHtml(player.username)}</h2>
						<div class="score-row">
							<p class="score">${total.toLocaleString()}</p>
							<div class="score-bar" aria-hidden="true">
								<span style="--score-width: ${scoreWidth}%"></span>
							</div>
						</div>
						<p class="score-label">contributions</p>
						${renderContributionGraph(player.data, player.username)}
						${dateRange}
					</article>
				`;
			}

			function renderContributionGraph(data: ContributionData, username: string) {
				const weeks = data.weeks ?? [];

				if (weeks.length === 0) {
					return '<p class="graph-empty">No contribution graph available.</p>';
				}

				const colors = getContributionColors(data.colors_full);
				const graphLabel = getContributionGraphLabel(data, username);
				const squares = weeks
					.flatMap((week, weekIndex) =>
						week.contribution_days.map((day, dayIndex) =>
							renderContributionSquare(
								day,
								week.first_day,
								dayIndex,
								colors,
								weekIndex * 7 + dayIndex
							)
						)
					)
					.join('');

				return `
					<div class="contribution-graph" role="img" tabindex="0" aria-label="${escapeHtml(graphLabel)}">
						${squares}
					</div>
				`;
			}

			function renderContributionSquare(
				day: ContributionDay,
				firstDay: string,
				dayIndex: number,
				colors: string[],
				squareIndex: number
			) {
				const count = Number.isFinite(day.count) ? day.count : 0;
				const level = Math.max(0, Math.min(colors.length - 1, day.level));
				const date = getContributionDate(firstDay, dayIndex);
				const label = `${count} contribution${count === 1 ? '' : 's'}${date ? ` on ${date}` : ''}`;

				return `
					<span
						class="contribution-square"
						style="--square-color: ${colors[level]}; --square-delay: ${Math.min(squareIndex * 4, 520)}ms"
						title="${escapeHtml(label)}"
						aria-hidden="true"
					></span>
				`;
			}

			function getContributionGraphLabel(data: ContributionData, username: string) {
				const total = data.total_contributions.toLocaleString();
				const dateRange = data.from && data.to ? ` from ${data.from} to ${data.to}` : '';

				return `${username}'s contribution graph: ${total} total contributions${dateRange}. Scroll horizontally to review the retro heatmap.`;
			}

			function getContributionColors(colors?: string[]) {
				const fallbackColors = ['#ebedf0', '#9be9a8', '#40c463', '#30a14e', '#216e39'];
				const validColors = colors?.filter((color) => /^#[\da-f]{3,8}$/i.test(color));

				return validColors?.length ? validColors : fallbackColors;
			}

			function getContributionDate(firstDay: string, dayIndex: number) {
				const date = new Date(`${firstDay}T00:00:00Z`);

				if (Number.isNaN(date.getTime())) {
					return '';
				}

				date.setUTCDate(date.getUTCDate() + dayIndex);

				return date.toISOString().slice(0, 10);
			}

			function renderMessage(
				message: string,
				tone: 'note' | 'loading' | 'error' = 'note'
			) {
				if (!results) {
					return;
				}

				const label =
					tone === 'error'
						? 'Error state'
						: tone === 'loading'
							? 'Loading'
							: 'Ready';

				results.setAttribute('aria-busy', tone === 'loading' ? 'true' : 'false');
				results.innerHTML = `
					<h2 id="results-heading" class="sr-only">Battle results</h2>
					<div class="message-state is-${tone}" ${tone === 'error' ? 'role="alert"' : ''}>
						<div>
							<strong class="message-label">${label}</strong>
							<p>${escapeHtml(message)}</p>
						</div>
						${
							tone === 'loading'
								? '<span class="loading-orb" aria-hidden="true"></span>'
								: tone === 'error'
									? '<span class="error-glyph" aria-hidden="true">!!</span>'
									: ''
						}
					</div>
				`;
			}

			function setBattleBusy(isBusy: boolean) {
				if (!battleButton) {
					return;
				}

				battleButton.disabled = isBusy;
				battleButton.setAttribute('aria-busy', String(isBusy));
			}

			function focusResults() {
				requestAnimationFrame(() => {
					results?.focus({ preventScroll: false });
				});
			}

			function clearFieldErrors() {
				clearFieldError(playerOneInput, playerOneError);
				clearFieldError(playerTwoInput, playerTwoError);
			}

			function setFieldError(
				input: HTMLInputElement | null,
				errorTarget: HTMLElement | null,
				message: string
			) {
				input?.classList.add('is-invalid');
				input?.setAttribute('aria-invalid', 'true');
				input?.closest('.player-field')?.classList.add('is-invalid');

				if (errorTarget) {
					errorTarget.textContent = message;
				}
			}

			function clearFieldError(
				input: HTMLInputElement | null,
				errorTarget: HTMLElement | null
			) {
				input?.classList.remove('is-invalid');
				input?.setAttribute('aria-invalid', 'false');
				input?.closest('.player-field')?.classList.remove('is-invalid');

				if (errorTarget) {
					errorTarget.textContent = '';
				}
			}

			function isValidGitHubUsername(username: string) {
				return (
					username.length <= 39 &&
					/^[a-z\d](?:[a-z\d-]{0,37}[a-z\d])?$/i.test(username) &&
					!username.includes('--')
				);
			}

			function getApiError(body: unknown) {
				if (
					body &&
					typeof body === 'object' &&
					'error' in body &&
					typeof body.error === 'string'
				) {
					return body.error;
				}

				return '';
			}

			function formatApiError(username: string, apiError: string, status: number) {
				if (status === 404) {
					return `No fighter found for @${username}. Check the handle and try again.`;
				}

				if (status === 400) {
					return `GitHub rejected @${username}. Use a valid username format.`;
				}

				if (status === 504) {
					return `GitHub timed out while loading @${username}. Retry the battle.`;
				}

				if (status >= 500) {
					return `Contribution feed glitched while loading @${username}. Try again in a moment.`;
				}

				return apiError || `Unable to fetch @${username}. Try again.`;
			}

			function escapeHtml(value: string) {
				return value.replace(/[&<>"']/g, (character) => {
					const entities: Record<string, string> = {
						'&': '&amp;',
						'<': '&lt;',
						'>': '&gt;',
						'"': '&quot;',
						"'": '&#39;',
					};

					return entities[character];
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		color-scheme: dark;
		--bg: #0a0a1a;
		--panel: rgba(14, 14, 38, 0.86);
		--text: #f5fff8;
		--muted: #a7a4c9;
		--accent: #5fed83;
		--purple: #8a2be2;
		--danger: #ff4fd8;
		--danger-hot: #ff6b6b;
		--accent-dark: #14361f;
		--border: rgba(95, 237, 131, 0.34);
		--purple-border: rgba(138, 43, 226, 0.42);
		--font-arcade: "Press Start 2P", ui-monospace, SFMono-Regular, Consolas, monospace;
	}

	* {
		box-sizing: border-box;
	}

	body {
		position: relative;
		margin: 0;
		min-height: 100svh;
		background:
			radial-gradient(circle at 18% 4%, rgba(95, 237, 131, 0.22), transparent 24rem),
			radial-gradient(circle at 82% 18%, rgba(138, 43, 226, 0.2), transparent 26rem),
			linear-gradient(135deg, #040411 0%, var(--bg) 52%, #070718 100%);
		color: var(--text);
		font-family: var(--font-arcade);
		text-rendering: geometricPrecision;
	}

	body::before,
	body::after {
		content: "";
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	body::before {
		background:
			repeating-linear-gradient(
				to bottom,
				rgba(255, 255, 255, 0.055) 0 1px,
				transparent 1px 5px
			),
			repeating-linear-gradient(
				to right,
				rgba(95, 237, 131, 0.035) 0 1px,
				transparent 1px 96px
			);
		mix-blend-mode: screen;
		opacity: 0.56;
		animation: scanline-drift 9s linear infinite;
	}

	body::after {
		background:
			radial-gradient(circle at center, transparent 0 46%, rgba(0, 0, 0, 0.46) 100%),
			linear-gradient(rgba(138, 43, 226, 0.035), rgba(95, 237, 131, 0.025));
		box-shadow: inset 0 0 120px rgba(0, 0, 0, 0.62);
		opacity: 0.88;
	}

	button,
	input {
		font: inherit;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 4px;
	}

	.arena {
		position: relative;
		z-index: 1;
		width: min(100% - 2rem, 960px);
		min-height: 100svh;
		margin: 0 auto;
		padding: 4rem 0;
		display: grid;
		align-content: center;
		gap: 2rem;
	}

	.hero {
		animation: rise-in 480ms ease-out both;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent);
		font-size: clamp(0.58rem, 1.4vw, 0.8rem);
		font-weight: 800;
		letter-spacing: 0.18em;
		line-height: 1.9;
		text-shadow:
			0 0 10px rgba(95, 237, 131, 0.72),
			0 0 22px rgba(138, 43, 226, 0.42);
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		color: var(--accent);
		font-size: clamp(2.45rem, 8vw, 6.6rem);
		line-height: 1.08;
		letter-spacing: -0.03em;
		text-shadow:
			0 0 4px rgba(245, 255, 248, 0.72),
			0 0 14px rgba(95, 237, 131, 0.9),
			0 0 32px rgba(95, 237, 131, 0.72),
			0 0 58px rgba(138, 43, 226, 0.72);
		text-transform: uppercase;
		animation: neon-pulse 2.8s ease-in-out infinite;
	}

	.intro {
		max-width: 34rem;
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: clamp(0.72rem, 1.45vw, 0.9rem);
		line-height: 2;
	}

	.battle-panel {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 1rem;
		align-items: end;
		padding-block: 1.5rem;
		border-block: 1px solid var(--border);
		animation: rise-in 560ms 80ms ease-out both;
	}

	.player-field {
		display: grid;
		gap: 0.5rem;
		animation: float-in 680ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
	}

	.player-field:nth-child(3) {
		animation-delay: 140ms;
	}

	label {
		color: var(--accent);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		line-height: 1.8;
		text-shadow: 0 0 12px rgba(95, 237, 131, 0.58);
		text-transform: uppercase;
	}

	input {
		width: 100%;
		border: 1px solid var(--border);
		border-radius: 0;
		background:
			linear-gradient(90deg, rgba(95, 237, 131, 0.06), rgba(138, 43, 226, 0.08)),
			rgba(10, 10, 26, 0.86);
		color: var(--text);
		padding: 1rem;
		outline: none;
		box-shadow:
			inset 0 0 24px rgba(95, 237, 131, 0.04),
			0 0 0 rgba(95, 237, 131, 0);
		transition:
			border-color 160ms ease,
			box-shadow 160ms ease,
			transform 160ms ease;
	}

	input:hover,
	input:focus {
		border-color: var(--accent);
		box-shadow:
			0 0 0 3px rgba(95, 237, 131, 0.14),
			0 0 26px rgba(138, 43, 226, 0.28);
		transform: translateY(-2px);
	}

	input:focus-visible {
		border-color: #f4fff7;
		box-shadow:
			0 0 0 4px rgba(10, 10, 26, 0.96),
			0 0 0 7px rgba(95, 237, 131, 0.9),
			0 0 32px rgba(95, 237, 131, 0.62),
			0 0 48px rgba(138, 43, 226, 0.42);
	}

	.player-field.is-invalid label {
		color: #ff9de8;
		text-shadow:
			0 0 10px rgba(255, 79, 216, 0.8),
			0 0 18px rgba(138, 43, 226, 0.48);
	}

	input.is-invalid,
	input[aria-invalid="true"] {
